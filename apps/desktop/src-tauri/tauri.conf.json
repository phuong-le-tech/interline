{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interline",
  "version": "0.1.0",
  "identifier": "app.interline.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Interline", "width": 1100, "height": 760 }],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": true, "icon": ["icons/icon.png"], "macOS": { "minimumSystemVersion": "14.2", "signingIdentity": "-" } }
}
