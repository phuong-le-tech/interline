#!/bin/sh
# Launcher for the MockAgent jar. Defaults point at the fixture files in this repository; later arguments win.
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../../../.." && pwd)
java_bin=java
if [ -n "$JAVA_HOME" ]; then java_bin="$JAVA_HOME/bin/java"; fi
exec "$java_bin" -jar "$here/../target/mock-agent-0.1.0-SNAPSHOT.jar" \
  --wav="$repo/fixtures/audio/standup-fr-2min.wav" \
  --script="$repo/fixtures/audio/standup-fr-2min.transcript.json" "$@"
